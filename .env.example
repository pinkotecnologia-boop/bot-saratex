# ============================================
# Saratex WhatsApp Bot — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores

# --- Meta WhatsApp Cloud API ---
# Obtener en: https://developers.facebook.com → Tu App → WhatsApp → API Setup
WHATSAPP_TOKEN=tu_token_de_acceso_permanente
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=saratex_webhook_2024

# --- Número del asesor para notificaciones ---
# Formato internacional sin +, ejemplo: 573001234567
ADVISOR_PHONE=573001234567

# --- Gemini API (Opcional, para IA) ---
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key

# --- Servidor ---
PORT=3000
